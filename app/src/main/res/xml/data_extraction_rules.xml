<?xml version="1.0" encoding="utf-8"?>
<!-- History can hold tag contents and identifiers, so nothing leaves the
     device through cloud backup or device-to-device transfer (spec § 10:
     local-first). Users move data explicitly with Settings › Export. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
